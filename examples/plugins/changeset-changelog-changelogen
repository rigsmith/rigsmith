#!/usr/bin/env node
// Reference changelog generator plugin — changelogen style (unjs/changelogen).
//
// This is BOTH a conformance test of the rigsmith changelog plugin contract
// (PLUGIN-PROTOCOL.md) and the implementation of the changelogen-style output
// requested for the project. It is intentionally written in Node, not Go, to
// prove the contract is language-agnostic: a plugin is "just another CLI we
// call" — JSON ChangelogRequest on stdin, rendered entry text on stdout.
//
// Install: put this file on your $PATH named `changeset-changelog-changelogen`
// (chmod +x), then set in .changeset/config.json:  "changelog": "changelogen"
// The engine resolves a bare name to `changeset-changelog-<name>` on PATH.
//
// Invocation: `changeset-changelog-changelogen render` with the request on stdin.
// Configured as ["changelogen", { "repo": "owner/name" }], the options object
// arrives as request.options, and its repo turns PR and commit references into
// links.
//
// changelogen groups by conventional-commit TYPE with emoji headings: a
// changeset's `type:` frontmatter (or its summary's conventional prefix) picks
// the section, and an untyped one maps its bump to the nearest section.

// Group by conventional TYPE (the request now carries change.type). A breaking
// change (change.breaking, i.e. a `!` on the type) always wins. Untyped changes
// fall back to a bump→type mapping so the plugin still works on bump-only changesets.
const TYPE_SECTIONS = {
  breaking: "### 💥 Breaking Changes",
  feat: "### 🚀 Enhancements",
  fix: "### 🩹 Fixes",
  perf: "### 🔥 Performance",
  refactor: "### 💅 Refactors",
  docs: "### 📖 Documentation",
  build: "### 📦 Build",
  test: "### ✅ Tests",
  chore: "### 🏡 Chore",
};
const ORDER = ["breaking", "feat", "fix", "perf", "refactor", "docs", "build", "test", "chore"];
const BUMP_TO_TYPE = { major: "breaking", minor: "feat", patch: "fix" };

function sectionKey(c) {
  if (c.breaking) return "breaking";
  if (c.type && TYPE_SECTIONS[c.type]) return c.type;
  if (c.type) return c.type; // unknown type → its own section
  return BUMP_TO_TYPE[c.bump] || "fix";
}

function read(stream) {
  return new Promise((resolve, reject) => {
    let data = "";
    stream.setEncoding("utf8");
    stream.on("data", (c) => (data += c));
    stream.on("end", () => resolve(data));
    stream.on("error", reject);
  });
}

// renderLine is one bullet: the scope as a lead-in, the summary's first line
// without its conventional prefix (the heading and lead-in say that), the
// rest of the summary indented beneath it, and a reference to the pull
// request, else the commit, linked when options.repo names the GitHub repo.
function renderLine(c, repo) {
  const lines = (c.summary || "").replace(/\r\n/g, "\n").trimEnd().split("\n");
  // The headline is the first line with text once its conventional prefix is
  // off: "feat:" alone, then a blank, then the text, is still a change, and so
  // is a summary that opens with a blank line.
  let at = -1;
  let head = "";
  for (let i = 0; i < lines.length && !head; i++) {
    if (!lines[i].trim()) continue;
    head = lines[i].replace(/^[a-zA-Z]+(\([^)]*\))?!?:\s*/, "").trim();
    at = i;
  }
  if (!head) return null;
  const rest = lines.slice(at + 1);
  const lead = c.scope ? `**${c.scope}:** ` : "";
  let ref = "";
  if (c.pr) ref = repo ? `[#${c.pr}](https://github.com/${repo}/pull/${c.pr})` : `#${c.pr}`;
  else if (c.commit) {
    const short = c.commit.slice(0, 7);
    ref = repo ? `[${short}](https://github.com/${repo}/commit/${c.commit})` : short;
  }
  const body = rest.map((l) => (l.trim() ? `  ${l.trimEnd()}` : "")).join("\n");
  return `- ${lead}${head}${ref ? ` (${ref})` : ""}${body ? `\n${body}` : ""}`;
}

(async () => {
  let req;
  try {
    req = JSON.parse(await read(process.stdin));
  } catch (e) {
    process.stderr.write("changelogen plugin: invalid JSON on stdin: " + e.message + "\n");
    process.exit(1);
  }

  if (req.apiVersion !== 1) {
    process.stderr.write(`changelogen plugin: unsupported apiVersion ${req.apiVersion} (speak 1)\n`);
    process.exit(1);
  }

  // Options arrive as req.options when configured as ["changelogen", { … }]:
  // { "repo": "owner/name" } links pull requests and commits.
  const repo = (req.options && req.options.repo) || "";

  // changelogen leads with the version as a heading (the engine still owns the
  // file's "# Title"); we render the "## <version>" entry block.
  const lines = [`## ${req.package.newVersion}`];

  // The "Updated dependencies" change is flagged; this plugin renders the
  // same thing from dependencyUpdates.
  const byType = {};
  for (const c of req.changes || []) {
    if (c.dependencies) continue;
    (byType[sectionKey(c)] ||= []).push(c);
  }

  // Scopes sort by the order the request carries — the engine's configured
  // changelogScopes — then alphabetically; unscoped changes come last, since
  // they belong to the section rather than to any tool in it.
  const scopeRank = new Map((req.scopeOrder || []).map((s, i) => [s, i]));
  const byScope = (a, b) => {
    const sa = a.scope || "";
    const sb = b.scope || "";
    if (sa === sb) return 0;
    if (!sa || !sb) return sa ? -1 : 1;
    const ra = scopeRank.has(sa) ? scopeRank.get(sa) : Infinity;
    const rb = scopeRank.has(sb) ? scopeRank.get(sb) : Infinity;
    return ra !== rb ? ra - rb : sa < sb ? -1 : 1;
  };

  let rendered = 0;
  // Known sections in changelogen order, then any unknown types alphabetically.
  const seen = new Set(ORDER);
  const extra = Object.keys(byType).filter((k) => !seen.has(k)).sort();
  for (const key of [...ORDER, ...extra]) {
    const bullets = [...(byType[key] || [])].sort(byScope).map((c) => renderLine(c, repo)).filter(Boolean);
    if (!bullets.length) continue;
    lines.push("", TYPE_SECTIONS[key] || `### ${key}`, "", ...bullets);
    rendered += bullets.length;
  }

  // The released dependencies, as the engine lists them.
  const deps = req.dependencyUpdates || [];
  if (deps.length) {
    lines.push("", "### 🌊 Dependencies", "", ...deps.map((d) => `- ${d.displayName || d.name}@${d.newVersion}`));
    rendered += deps.length;
  }

  if (!rendered) lines.push("", "No changes in this release.");

  // The release's contributors, as the engine resolved them (the
  // `contributors` config), linked when a GitHub login is known.
  const contributors = req.contributors || [];
  if (contributors.length) {
    lines.push("", `### ${req.contributorsSection || "❤️ Contributors"}`, "");
    for (const a of contributors) {
      const name = a.name || a.login;
      lines.push(a.login ? `- ${name} ([@${a.login}](https://github.com/${a.login}))` : `- ${name}`);
    }
  }

  process.stdout.write(lines.join("\n") + "\n");
})();
