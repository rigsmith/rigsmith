# winget-pkgs manifests are CRLF, and the check that reads them has been broken
# by a stray \r before. These fixtures are captured from real komac output, so
# git must store them byte for byte — normalising them to LF would leave the
# CRLF test passing against a file that no longer has any CRLF in it.
scripts/testdata/winget-komac/*.yaml -text

.github/workflows/*.lock.yml linguist-generated=true
